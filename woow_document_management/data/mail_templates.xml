<odoo>
  <data noupdate="1">
    <record id="mail_template_woow_document_member_notice" model="mail.template">
      <field name="name">Document folder notice</field>
      <field name="model_id" ref="model_woow_document_folder"/>
      <field name="subject">A document folder was shared with you</field>
      <field name="body_html" type="html">
        <div>
          <p>A document folder is available:</p>
          <p><a t-att-href="ctx.get('woow_notice_url')"><t t-out="ctx.get('woow_notice_url')"/></a></p>
          <p t-if="ctx.get('woow_notice_note')"><t t-out="ctx.get('woow_notice_note')"/></p>
        </div>
      </field>
    </record>
  </data>
</odoo>
