<odoo>
  <record id="view_woow_document_share_list" model="ir.ui.view">
    <field name="name">woow.document.share.list</field>
    <field name="model">woow.document.share</field>
    <field name="arch" type="xml">
      <list string="Share links" create="0" delete="0">
        <field name="name"/>
        <field name="share_type"/>
        <field name="recipient_email"/>
        <field name="token_hint"/>
        <field name="expire_at"/>
        <field name="state"/>
        <field name="download_count"/>
      </list>
    </field>
  </record>
  <record id="view_woow_document_share_form" model="ir.ui.view">
    <field name="name">woow.document.share.form</field>
    <field name="model">woow.document.share</field>
    <field name="arch" type="xml">
      <form string="Share link" create="0" delete="0">
        <header>
          <button name="action_revoke" string="Revoke" type="object" invisible="state != 'active'"/>
          <button name="action_reissue" string="Replace link" type="object"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet><group>
          <field name="name"/>
          <field name="share_type" readonly="1"/>
          <field name="folder_id" readonly="1" invisible="share_type != 'folder'"/>
          <field name="document_ids" readonly="1" invisible="share_type != 'documents'"/>
          <field name="recipient_email" readonly="1"/>
          <field name="token_hint" readonly="1"/>
          <field name="has_password" readonly="1"/>
          <field name="expire_at"/>
          <field name="max_downloads" readonly="1"/>
          <field name="download_count" readonly="1"/>
        </group></sheet>
      </form>
    </field>
  </record>
  <record id="action_woow_document_share" model="ir.actions.act_window">
    <field name="name">Share links</field>
    <field name="res_model">woow.document.share</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
