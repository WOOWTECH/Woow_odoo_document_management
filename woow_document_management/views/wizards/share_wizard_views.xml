<odoo>
  <record id="view_woow_document_share_wizard_form" model="ir.ui.view">
    <field name="name">woow.document.share.wizard.form</field>
    <field name="model">woow.document.share.wizard</field>
    <field name="arch" type="xml">
      <form string="Create share links">
        <group>
          <field name="share_type"/>
          <field name="folder_id" invisible="share_type != 'folder'" required="share_type == 'folder'"/>
          <field name="document_ids" widget="many2many_tags" invisible="share_type != 'documents'"/>
          <field name="include_subfolders" invisible="share_type != 'folder'"/>
          <field name="recipient_emails" placeholder="One email address per line; leave blank for a manual link"/>
          <field name="expire_at"/>
          <field name="max_downloads"/>
          <field name="password" password="True" autocomplete="off"/>
          <field name="note"/>
        </group>
        <footer>
          <button name="action_create_links" string="Create links" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
