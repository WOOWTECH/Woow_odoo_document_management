<odoo>
  <record id="view_woow_document_shortcut_wizard_form" model="ir.ui.view">
    <field name="name">woow.document.shortcut.wizard.form</field>
    <field name="model">woow.document.shortcut.wizard</field>
    <field name="arch" type="xml">
      <form string="Create a shortcut">
        <group>
          <field name="document_id" readonly="1" force_save="1" options="{'no_open': True}"/>
          <field name="folder_id" domain="[('in_trash', '=', False)]" options="{'no_create': True}"/>
        </group>
        <footer>
          <button name="action_create" string="Create shortcut" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
