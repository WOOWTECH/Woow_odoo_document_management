<odoo>
  <record id="view_woow_document_rename_wizard_form" model="ir.ui.view">
    <field name="name">woow.document.rename.wizard.form</field>
    <field name="model">woow.document.rename.wizard</field>
    <field name="arch" type="xml">
      <form string="Rename">
        <field name="document_id" invisible="1"/>
        <field name="folder_id" invisible="1"/>
        <group>
          <field name="name"/>
        </group>
        <footer>
          <button name="action_rename" string="Rename" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
