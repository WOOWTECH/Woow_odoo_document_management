<odoo>
  <record id="view_woow_document_notify_wizard_form" model="ir.ui.view">
    <field name="name">woow.document.notify.wizard.form</field>
    <field name="model">woow.document.notify.wizard</field>
    <field name="arch" type="xml">
      <form string="Notify members">
        <group>
          <field name="folder_id"/>
          <field name="all_members"/>
          <field name="recipient_ids" widget="many2many_tags" invisible="all_members"/>
          <field name="note"/>
        </group>
        <footer>
          <button name="action_send" string="Send" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
