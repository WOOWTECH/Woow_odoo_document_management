<odoo>
  <record id="view_woow_document_trash_folder_list" model="ir.ui.view">
    <field name="name">woow.document.folder.trash.list</field><field name="model">woow.document.folder</field>
    <field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="name"/><field name="parent_id"/><field name="trashed_date"/><field name="trashed_by_id"/><field name="woow_user_rank" column_invisible="True"/><button name="action_restore" string="Restore" type="object" invisible="woow_user_rank != 4"/></list></field>
  </record>
  <record id="action_woow_document_trash" model="ir.actions.act_window">
    <field name="name">Trash</field><field name="res_model">woow.document.folder</field><field name="view_mode">list,form</field>
    <field name="view_id" ref="view_woow_document_trash_folder_list"/>
    <field name="domain">[('in_trash', '=', True)]</field><field name="context">{'active_test': False}</field>
  </record>
  <record id="view_woow_document_trash_document_list" model="ir.ui.view">
    <field name="name">woow.document.trash.list</field><field name="model">woow.document</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <field name="name"/><field name="folder_id"/><field name="trashed_date"/>
        <field name="trashed_by_id"/>
        <button name="action_restore" string="Restore" type="object"/>
        <button name="action_purge" string="Delete permanently" type="object"
                groups="woow_document_management.group_woow_document_manager"/>
      </list>
    </field>
  </record>
  <record id="action_woow_document_trash_documents" model="ir.actions.act_window">
    <field name="name">Deleted files</field><field name="res_model">woow.document</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_woow_document_trash_document_list"/>
    <field name="domain">[('active', '=', False), ('folder_in_trash', '=', False)]</field>
    <field name="context">{'active_test': False}</field>
  </record>
</odoo>
