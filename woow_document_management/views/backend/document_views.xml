<odoo>
  <record id="view_woow_document_document_list" model="ir.ui.view"><field name="name">woow.document.list</field><field name="model">woow.document</field><field name="arch" type="xml"><list delete="0"><field name="name"/><field name="folder_id"/><field name="document_type"/><field name="owner_id"/><field name="file_size"/></list></field></record>
  <record id="view_woow_document_document_form" model="ir.ui.view"><field name="name">woow.document.form</field><field name="model">woow.document</field><field name="arch" type="xml"><form string="Document" delete="0"><header><button name="action_open_move_wizard" string="Move" type="object"/></header><sheet><group><field name="name"/><field name="folder_id"/><field name="document_type"/><field name="datas"/><field name="url"/><field name="description"/><field name="tag_ids"/><field name="owner_id"/></group></sheet><field name="woow_has_portal_members" invisible="1"/><div class="alert alert-warning" role="alert" invisible="not woow_has_portal_members">This folder has portal members. Messages you send are emailed to every follower, including people outside the company. Use Log note for internal discussion.</div><chatter/></form></field></record>
  <record id="view_woow_document_document_search" model="ir.ui.view"><field name="name">woow.document.search</field><field name="model">woow.document</field><field name="arch" type="xml"><search><field name="name"/><searchpanel><field name="folder_id" hierarchize="0"/></searchpanel></search></field></record>
  <record id="action_woow_document_document" model="ir.actions.act_window"><field name="name">Documents</field><field name="res_model">woow.document</field><field name="view_mode">list,form</field><field name="domain">[('active', '=', True), ('folder_in_trash', '=', False)]</field></record>
</odoo>
