<odoo>
    <template id="share_landing" name="Open a document link">
        <html><head><title>Open a document link</title>
            <t t-call-assets="woow_document_management.assets_share" t-js="true"/>
        </head><body>
            <h1>Open a document link</h1>
            <form method="post" action="/woow-docs/s/open">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <label>Paste the complete link or its code
                    <input type="text" name="link" maxlength="2048" autocomplete="off" required="required"/>
                </label>
                <button type="submit">Open</button>
            </form>
        </body></html>
    </template>
    <template id="share_page" name="Shared documents">
        <html><head><title>Shared documents</title></head><body>
            <h1>Shared documents</h1>
            <p t-out="company_name"/>
            <ul>
                <li t-foreach="docs" t-as="doc">
                    <a t-if="doc.document_type == 'binary'"
                       t-att-href="'/woow-docs/s/%d/file/%d' % (share_id, doc.id)"
                       t-out="doc.name"/>
                    <span t-else="" t-out="doc.name"/>
                </li>
            </ul>
        </body></html>
    </template>
    <template id="share_password" name="Unlock a document link">
        <html><head><title>Unlock a document link</title></head><body>
            <h1>Unlock a document link</h1>
            <form method="post" t-att-action="'/woow-docs/s/%d/unlock' % share_id">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="password" name="password" autocomplete="off" required="required"/>
                <button type="submit">Unlock</button>
            </form>
        </body></html>
    </template>
</odoo>
