<templates xml:space="preserve">
  <t t-name="woow_document_management.ShareResult">
    <div class="o_form_view container py-4">
      <h2>Share links</h2>
      <p>Copy these links now. They will not be shown again.</p>
      <ul class="list-unstyled">
        <li t-foreach="links" t-as="link" t-key="link" class="mb-3">
          <a t-att-href="link" target="_blank" rel="noopener noreferrer" t-esc="link"/>
          <button type="button" class="btn btn-secondary ms-2" t-on-click="() => this.copyLink(link)">Copy</button>
        </li>
      </ul>
    </div>
  </t>
</templates>
