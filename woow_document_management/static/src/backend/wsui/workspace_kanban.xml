<templates xml:space="preserve">

    <t t-name="woow_document_management.WorkspaceKanbanView" t-inherit="web.KanbanView" t-inherit-mode="primary">
        <xpath expr="//Layout" position="attributes">
            <attribute name="display">wooDisplay</attribute>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-navigation-additional']" position="inside">
            <button t-if="ws.inspector" type="button" class="btn btn-secondary o_woow_info_toggle" t-att-class="{'active': ws.state.showInfo}" title="Details" t-on-click="() => ws.toggleInfo()">
                <i class="fa fa-info-circle"/>
            </button>
        </xpath>
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']" position="after">
            <t t-set-slot="control-panel-selection-actions">
                <WooSelectionBar ws="ws" selection="ws.selectedIds"/>
            </t>
        </xpath>
        <xpath expr="//t[@t-component='props.Renderer']" position="after">
            <WooInspectorPane ws="ws" selection="ws.selectedIds"/>
            <div t-if="ws.state.dropping" class="woow-drop-overlay" aria-hidden="true">
                <div class="woow-drop-message"><i class="fa fa-cloud-upload fa-2x"/><div>Drop the files to upload them to this folder</div></div>
            </div>
        </xpath>
    </t>

    <t t-name="woow_document_management.WorkspaceKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="attributes">
            <attribute name="t-on-click">onBackgroundClick</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='getGroupsOrRecords()']" position="before">
            <WooUploadStatus/>
            <WooFolderStrip/>
        </xpath>
    </t>

    <t t-name="woow_document_management.WorkspaceKanbanRecord" t-inherit="web.KanbanRecord" t-inherit-mode="primary">
        <xpath expr="//article" position="attributes">
            <attribute name="t-on-dblclick">onDoubleClick</attribute>
            <attribute name="draggable">true</attribute>
            <attribute name="t-on-dragstart">onDragStart</attribute>
            <attribute name="t-on-dragend">onDragEnd</attribute>
            <attribute name="t-on-keydown">onKeydown</attribute>
        </xpath>
    </t>

</templates>
