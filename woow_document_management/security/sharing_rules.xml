<odoo>
    <!-- Rules of woow.document.share (release 18.0.2, lane sharing). Portal users have no ACL row
         and no rule: a share row is never theirs to read. -->
    <record id="rule_woow_document_share_company" model="ir.rule">
        <field name="name">R-S0 rule_woow_document_share_company</field>
        <field name="model_id" ref="model_woow_document_share" />
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
    <!-- A document user reads the rows of the documents that he reads, as R-D1 judges it: in release
         18.0.1 the lists were readable by everyone who reads the document. The conditions are written
         out because the rules of a record that a domain reaches with ``any`` are not applied
         there (the sub-search of a rule runs without them). The first condition keeps archived
         documents in the search: whether one is readable is R-D1's own test. -->
    <record id="rule_woow_document_share_user_read" model="ir.rule">
        <field name="name">R-S1 rule_woow_document_share_user_read</field>
        <field name="model_id" ref="model_woow_document_share" />
        <field name="domain_force">[('document_id', 'any', ['&amp;', ('active', 'in', [True, False]), '&amp;', ('folder_in_trash', '=', False), '|', '&amp;', ('active', '=', True), '|', '|', ('folder_id', 'any', ['|', ('eff_read_user_ids', 'in', [user.id]), ('eff_read_group_ids', 'in', user.groups_id.ids)]), ('shared_user_ids', 'in', [user.id]), '&amp;', ('owner_id', '=', user.id), ('folder_id', 'any', ['|', ('eff_upload_user_ids', 'in', [user.id]), ('eff_upload_group_ids', 'in', user.groups_id.ids)]), '|', ('folder_id', 'any', ['|', ('eff_edit_user_ids', 'in', [user.id]), ('eff_edit_group_ids', 'in', user.groups_id.ids)]), '&amp;', ('owner_id', '=', user.id), ('folder_id', 'any', ['|', ('eff_upload_user_ids', 'in', [user.id]), ('eff_upload_group_ids', 'in', user.groups_id.ids)])])]</field>
        <field name="groups" eval="[(4, ref('group_woow_document_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <!-- Rows of a folder are read by those who hold the manage level of it, a document in the
         trash included: the lists are rebuilt from all the rows of a document and a manager must not
         be blind to the rows of an archived one. A folder in the trash hides its documents from its
         manager (R-D1), and so it hides their rows: who the documents were shared with is not
         told to someone who cannot read them. They come back with the folder. -->
    <record id="rule_woow_document_share_user_manage" model="ir.rule">
        <field name="name">R-S2 rule_woow_document_share_user_manage</field>
        <field name="model_id" ref="model_woow_document_share" />
        <field name="domain_force">[('folder_id', 'any', ['&amp;', ('in_trash', '=', False), '|', ('eff_manage_user_ids', 'in', [user.id]), ('eff_manage_group_ids', 'in', user.groups_id.ids)])]</field>
        <field name="groups" eval="[(4, ref('group_woow_document_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <!-- Rows are created, changed and removed by the same people, whether the folder is in the
         trash or not: each change asks for the document itself first (``_woow_require_manage``),
         which a trashed folder refuses. -->
    <record id="rule_woow_document_share_user_manage_change" model="ir.rule">
        <field name="name">R-S4 rule_woow_document_share_user_manage_change</field>
        <field name="model_id" ref="model_woow_document_share" />
        <field name="domain_force">[('folder_id', 'any', ['|', ('eff_manage_user_ids', 'in', [user.id]), ('eff_manage_group_ids', 'in', user.groups_id.ids)])]</field>
        <field name="groups" eval="[(4, ref('group_woow_document_user'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
    <record id="rule_woow_document_share_manager" model="ir.rule">
        <field name="name">R-S3 rule_woow_document_share_manager</field>
        <field name="model_id" ref="model_woow_document_share" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_woow_document_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>
