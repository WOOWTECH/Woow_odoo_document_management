    <!-- R-W1..R-W6: a wizard row belongs to the user who created it. Core has no owner rule
         for transient models, and the actions of these wizards run with the rights of whoever
         calls them on the stored row, so another document user must not read or change a row
         that an administrator is about to confirm. Every ACL of these models is read, write
         and create only; the rule restricts all four operations to the creator's own rows. -->
    <record id="rule_woow_document_share_wizard_owner" model="ir.rule">
        <field name="name">R-W1 rule_woow_document_share_wizard_owner</field>
        <field name="model_id" ref="model_woow_document_share_wizard" />
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_woow_document_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>
