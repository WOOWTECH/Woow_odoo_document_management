<!-- PR-01, final on day 0. No users field here: the administrator assignment is a separate
     noupdate record in data/admin_assignment.xml (ER-38). base.group_user does NOT imply the
     document user group (DEC-10): internal users become document users only when assigned. -->
<odoo>
    <record id="module_category_woow_document" model="ir.module.category">
        <field name="name">Documents (WoowTech)</field>
        <field name="description">Access to folders, documents and share links.</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_woow_document_user" model="res.groups">
        <field name="name">Document User</field>
        <field name="category_id" ref="module_category_woow_document"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Works in the folders where they are members.</field>
    </record>

    <record id="group_woow_document_manager" model="res.groups">
        <field name="name">Document Administrator</field>
        <field name="category_id" ref="module_category_woow_document"/>
        <field name="implied_ids" eval="[(4, ref('group_woow_document_user'))]"/>
        <field name="comment">Sees every folder, manages tags, the trash, legal holds and the audit log.</field>
    </record>

    <record id="group_woow_document_attachment_overview" model="res.groups">
        <field name="name">Attachment Overview</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can open the overview of attachments stored on other records.</field>
    </record>
</odoo>
