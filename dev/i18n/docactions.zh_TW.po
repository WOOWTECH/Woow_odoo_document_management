# Traditional Chinese translation of the strings added by lane docactions (lock, rename, duplicate).
# The integrator merges these entries into i18n/zh_TW.po when the catalog is regenerated.
# Wording follows docs/i18n-glossary.md.
msgid ""
msgstr ""
"Language: zh_TW\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Locked by"
msgstr "鎖定者"

msgid "Locked on"
msgstr "鎖定時間"

msgid "Locked"
msgstr "已鎖定"

msgid "Locked by me"
msgstr "我鎖定的"

msgid "Lock"
msgstr "鎖定"

msgid "Unlock"
msgstr "解除鎖定"

msgid "Duplicate"
msgstr "建立複本"

msgid "Rename"
msgstr "重新命名"

msgid "Copies"
msgstr "複本"

msgid "(copy)"
msgstr "(複本)"

msgid "New name"
msgstr "新名稱"

msgid "Rename a document or folder"
msgstr "重新命名文件或資料夾"

msgid "This filter is not supported."
msgstr "不支援這個篩選條件。"

msgid "This document is locked by another user."
msgstr "這份文件已被其他使用者鎖定。"

msgid "This document is locked by another user. Its details cannot be changed until it is unlocked."
msgstr "這份文件已被其他使用者鎖定，解除鎖定前無法變更內容。"

msgid "Select fewer documents."
msgstr "請選擇較少的文件。"

msgid "This document is unavailable."
msgstr "無法使用這份文件。"

msgid "You cannot unlock this document."
msgstr "您無法解除這份文件的鎖定。"

msgid "You cannot duplicate documents."
msgstr "您無法建立文件複本。"

msgid "Select at least one document."
msgstr "請至少選擇一份文件。"

msgid "Select at most %(count)s documents to duplicate at once."
msgstr "一次最多只能複製 %(count)s 份文件。"

msgid "This kind of document cannot be duplicated."
msgstr "這種文件無法建立複本。"

msgid "This document has no file to duplicate."
msgstr "這份文件沒有可複製的檔案。"

msgid "Choose one document or one folder to rename."
msgstr "請選擇一份文件或一個資料夾來重新命名。"

msgid "A name is required."
msgstr "請輸入名稱。"

msgid "This item is unavailable."
msgstr "無法使用這個項目。"
