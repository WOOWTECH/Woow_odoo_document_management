# Traditional Chinese text of the PDF split and merge feature (lane pdftools, release 18.0.2.0.0).
# Plain PO: msgid is the English source exactly as in the code or the views. The integrator
# merges this file into woow_document_management/i18n/zh_TW.po.
msgid ""
msgstr ""
"Language: zh_TW\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Split PDF"
msgstr "分割 PDF"

msgid "Merge PDF files"
msgstr "合併 PDF 檔案"

msgid "PDF tools"
msgstr "PDF 工具"

msgid "New documents"
msgstr "新文件"

msgid "PDF split"
msgstr "PDF 已分割"

msgid "PDF merged"
msgstr "PDF 已合併"

msgid "Split a PDF document"
msgstr "分割 PDF 文件"

msgid "Merge PDF documents"
msgstr "合併 PDF 文件"

msgid "A PDF document in the order of a merge"
msgstr "合併順序中的 PDF 文件"

msgid "Shared steps of the PDF split and merge wizards"
msgstr "PDF 分割與合併精靈的共用步驟"

msgid "Document"
msgstr "文件"

msgid "Folder"
msgstr "資料夾"

msgid "Sequence"
msgstr "順序"

msgid "Merge"
msgstr "合併"

msgid "Split"
msgstr "分割"

msgid "Cancel"
msgstr "取消"

msgid "Split by"
msgstr "分割方式"

msgid "Page ranges"
msgstr "頁碼範圍"

msgid "One document per page"
msgstr "每頁一份文件"

msgid "Pages"
msgstr "頁碼"

msgid "PDF files"
msgstr "PDF 檔案"

msgid "File name"
msgstr "檔案名稱"

msgid "Can trash the original"
msgstr "可將原檔移到回收桶"

msgid "Move the original to the trash"
msgstr "將原檔移到回收桶"

msgid "Move the originals to the trash"
msgstr "將原檔移到回收桶"

msgid "Every part becomes a new document in the same folder, with the tags of the original. The original is kept unless you choose to move it to the trash."
msgstr "每個部分都會成為同一資料夾中的新文件，並帶有原檔的標籤。除非您選擇移到回收桶，否則原檔會保留。"

msgid "The files are joined from top to bottom. Drag the handle to change the order. The originals are kept; only the ones you may edit are moved to the trash when you choose that."
msgstr "檔案依由上到下的順序合併。拖曳把手可調整順序。原檔會保留；若您選擇移到回收桶，只有您可編輯的原檔會被移走。"

msgid "Only internal users can split or merge PDF files."
msgstr "只有內部使用者可以分割或合併 PDF 檔案。"

msgid "Type the pages like this: 1-3, 4, 5-8."
msgstr "請這樣輸入頁碼：1-3, 4, 5-8。"

msgid "A page is outside the file, which has %(pages)s pages."
msgstr "有頁碼超出檔案範圍，此檔案共有 %(pages)s 頁。"

msgid "The page ranges must not overlap."
msgstr "頁碼範圍不可重疊。"

msgid "At most %(limit)s documents can be made at once."
msgstr "一次最多可產生 %(limit)s 份文件。"

msgid "A password protected PDF file cannot be used."
msgstr "無法使用有密碼保護的 PDF 檔案。"

msgid "A PDF file with more than %(limit)s pages cannot be used."
msgstr "無法使用超過 %(limit)s 頁的 PDF 檔案。"

msgid "The PDF file is damaged or is not a PDF file."
msgstr "此 PDF 檔案已損毀，或不是 PDF 檔案。"

msgid "The selected document is unavailable."
msgstr "所選文件無法使用。"

msgid "Only PDF files can be split or merged."
msgstr "只有 PDF 檔案可以分割或合併。"

msgid "The target folder is unavailable."
msgstr "目標資料夾無法使用。"

msgid "Choose how to split the file."
msgstr "請選擇檔案的分割方式。"

msgid "page %(first)s"
msgstr "第 %(first)s 頁"

msgid "pages %(first)s-%(last)s"
msgstr "第 %(first)s-%(last)s 頁"

msgid "%(count)s documents were made from the PDF file."
msgstr "已從 PDF 檔案產生 %(count)s 份文件。"

msgid "The original was moved to the trash."
msgstr "原檔已移到回收桶。"

msgid "You cannot trash the original, so it was kept."
msgstr "您無法將原檔移到回收桶，因此已保留。"

msgid "Choose between %(least)s and %(most)s PDF files to merge."
msgstr "請選擇 %(least)s 到 %(most)s 個要合併的 PDF 檔案。"

msgid "Give the merged file a name."
msgstr "請為合併後的檔案命名。"

msgid "The merged file would be larger than the upload limit."
msgstr "合併後的檔案會超過上傳大小上限。"

msgid "The PDF files were merged into one document of %(pages)s pages."
msgstr "PDF 檔案已合併為一份共 %(pages)s 頁的文件。"

msgid "%(count)s of the originals were moved to the trash."
msgstr "已有 %(count)s 個原檔移到回收桶。"
