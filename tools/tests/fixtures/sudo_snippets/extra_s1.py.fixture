#! target=woow_document_management/models/document_log.py expect=SUDO-COUNT
from odoo import api, models


class WoowDocumentLog(models.Model):
    _name = 'woow.document.log'

    @api.model
    def _log_event(self, event, **kw):
        self.sudo().create({'event': event})  # sudo-ok: S1
        return self.sudo().create({'event': event})  # sudo-ok: S1
