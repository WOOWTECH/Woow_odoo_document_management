#! target=woow_document_management/models/document_log.py expect=SUDO-NOT-ALLOWED
from odoo import api, models


class WoowDocumentLog(models.Model):
    _inherit = ['woow.document.log', 'mail.thread']

    @api.model
    def _log_event(self, event, **kw):
        return self.sudo().create({'event': event})  # sudo-ok: S1
