#! target=woow_document_management/models/share_service.py expect=SUDO-S2-SHAPE
from odoo import api, models


class WoowDocumentShareService(models.Model):
    _inherit = 'woow.document.share'

    @api.model
    def _resolve_request_access(self, token=None, share_id=None):
        share_sudo = self.sudo().search([('name', 'ilike', token)])  # sudo-ok: S2
        scope_env = share_sudo.with_user(self.env.user)  # sudo-drop: S2
        return scope_env
