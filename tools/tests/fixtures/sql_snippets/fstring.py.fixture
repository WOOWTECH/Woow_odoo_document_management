def _usage_bytes(self, table):
    self.env.cr.execute(f'SELECT * FROM {table}')  # sql-ok: Q2
    self.env.cr.execute('SELECT * FROM %s' % table)  # sql-ok: Q2
    self.env.cr.execute('SELECT * FROM {}'.format(table))  # sql-ok: Q2
    self.env.cr.execute('SELECT * FROM ' + table)  # sql-ok: Q2
