from odoo import models


class WoowDocumentAutoRule(models.Model):
    _name = 'woow.document.auto.rule'

    def _woow_elevated(self):
        return self.sudo().with_context(x=1)  # sudo-ok: A1

    def _woow_creator_readable(self):
        return self.env['res.partner'].with_user(self.create_uid)  # sudo-ok: A2
