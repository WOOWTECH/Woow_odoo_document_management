import hashlib

from . import streaming


def f(self, request, folder, kw):
    request.session['woow_doc_state'] = dict(request.session.get('woow_doc_state') or {})
    digest = hashlib.sha256(b'x').hexdigest()
    target = request.redirect('/my/docs/folder/%d' % folder.id, local=True)
    number = int(kw.get('n') or 0)
    if not folder:
        return streaming.uniform_404('page')
    return digest, target, number
